#!/usr/bin/env bash

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/PROGRAMMING/dotfiles_config}"
GIT_CMD="/usr/bin/git -C $DOTFILES_DIR"

stage_all() {
    # Automatically stage all modified tracked files and the helper
    $GIT_CMD add -u
    $GIT_CMD add "$DOTFILES_DIR/.local/bin/dotfiles-git" 2>/dev/null || true
}

case "$1" in
    commit)
        stage_all
        $GIT_CMD "$@"
        ;;
    push)
        stage_all
        if ! $GIT_CMD diff --cached --quiet; then
            $GIT_CMD commit -m "sync: update dotfiles and dotfiles-git helper"
        fi
        $GIT_CMD "$@"
        ;;
    add)
        shift
        files=()
        for f in "$@"; do
            rel_path=$(realpath --relative-to="$DOTFILES_DIR" "$f" 2>/dev/null || echo "$f")
            files+=("$rel_path")
        done
        $GIT_CMD add "${files[@]}"
        ;;
    *)
        $GIT_CMD "$@"
        ;;
esac
