#!/usr/bin/env bash

if [ -z "$DOTFILES_DIR" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    DOTFILES_DIR="$(git -C "$SCRIPT_DIR/.." rev-parse --show-toplevel 2>/dev/null || (cd "$SCRIPT_DIR/../.." 2>/dev/null && pwd) || echo "$HOME/PROGRAMMING/dotfiles_config")"
fi
GIT_CMD="/usr/bin/git -C $DOTFILES_DIR"

stage_all() {
    # If hyprland.lua was temporarily disabled, preserve it in the git index
    if [ -f "$DOTFILES_DIR/.config/hypr/hyprland.lua.disabled" ] && [ ! -f "$DOTFILES_DIR/.config/hypr/hyprland.lua" ]; then
        cp "$DOTFILES_DIR/.config/hypr/hyprland.lua.disabled" "$DOTFILES_DIR/.config/hypr/hyprland.lua"
        $GIT_CMD add "$DOTFILES_DIR/.config/hypr/hyprland.lua"
        rm -f "$DOTFILES_DIR/.config/hypr/hyprland.lua"
    fi
    # Automatically stage all modified tracked files and helpers
    $GIT_CMD add -u
    $GIT_CMD add "$DOTFILES_DIR/.local/bin/dotfiles-git" 2>/dev/null || true
    $GIT_CMD add "$DOTFILES_DIR/.local/bin/hypr-lua" "$DOTFILES_DIR/.local/bin/hypr-conf" "$DOTFILES_DIR/.local/bin/hypr-status" "$DOTFILES_DIR/.local/bin/thunar-terminal" 2>/dev/null || true
}

case "$1" in
    commit)
        stage_all
        $GIT_CMD "$@"
        ;;
    push)
        stage_all
        if ! $GIT_CMD diff --cached --quiet; then
            $GIT_CMD commit -m "sync: update dotfiles and dotfiles-git helper"
        fi
        $GIT_CMD "$@"
        ;;
    add)
        shift
        files=()
        for f in "$@"; do
            rel_path=$(realpath --relative-to="$DOTFILES_DIR" "$f" 2>/dev/null || echo "$f")
            files+=("$rel_path")
        done
        $GIT_CMD add "${files[@]}"
        ;;
    *)
        $GIT_CMD "$@"
        ;;
esac
